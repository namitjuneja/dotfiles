!/mozilla/
/mozilla/*
!/mozilla/firefox/
/mozilla/firefox/*
!/mozilla/firefox/*/
/mozilla/firefox/*/*
!/mozilla/firefox/*/chrome/
/mozilla/firefox/*/chrome/*
